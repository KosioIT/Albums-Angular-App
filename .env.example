# ============================
# Backend Server Configuration
# ============================

# Port for Express server
API_PORT=3000

# Backend API URL (requires dotenv-expand)
API_URL=http://localhost:${API_PORT}

# Frontend application URL
APP_URL=http://localhost:4200


# ============================
# Authentication
# ============================

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:4200
ACCESS_TOKEN_TTL=15m
COOKIE_SAMESITE=strict

# JWT secret key (generate a strong one!)
JWT_SECRET=your_jwt_secret_here


# ============================
# Email (Nodemailer)
# ============================

# Optional fallback SMTP (Mailgun recommended)
FALLBACK_SMTP_HOST=smtp.mailgun.org
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_SECURE=false


# ============================
# Seed scripts (backend/db)
# ============================

# Public Mega folder with the album archives, used by "npm run r2:upload" (copies them to R2).
# Never commit the real link: it gives access to every archive.
# Keep the double quotes: without them dotenv treats "#" as a comment and drops the key.
MEGA_ALBUMS_FOLDER_URL="https://mega.nz/folder/<folder-id>#<folder-key>"


# ============================
# Album downloads (Cloudflare R2, S3-compatible)
# ============================

# R2 > Manage API Tokens > Account API token with "Object Read & Write" on this bucket only.
# Keep the bucket private: users get one-minute presigned links.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=


# ============================
# Reverse proxy
# ============================

# Set to 1 when the backend runs behind one proxy (Nginx, Render, Heroku...), so guest listens and
# rate limits see the visitor's IP instead of the proxy's. Leave unset for local development.
# TRUST_PROXY=1


# ============================
# Environment
# ============================

# dev or production
NODE_ENV=development