# ============================
# Backend Server Configuration
# ============================

# Port for Express server
API_PORT=3000

# Backend API URL (requires dotenv-expand)
API_URL=http://localhost:${API_PORT}

# Frontend application URL
APP_URL=http://localhost:4200


# ============================
# Authentication
# ============================

# JWT secret key (generate a strong one!)
JWT_SECRET=your_jwt_secret_here


# ============================
# Email (Nodemailer)
# ============================

# SMTP credentials
SMTP_USER=your_real_email@gmail.com
SMTP_PASS=your_real_email_password_or_app_password

# Optional fallback SMTP (Mailgun recommended)
FALLBACK_SMTP_HOST=smtp.mailgun.org
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_SECURE=false


# ============================
# Environment
# ============================

# dev or production
NODE_ENV=development
z